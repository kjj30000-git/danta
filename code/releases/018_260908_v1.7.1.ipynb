    "# ============================================================\n",
    "# ★ 내일 운용 핵심 설정 — 실행 전 확인\n",
    "# ============================================================\n",
    "\n",
    "AUTO_TRADE_ENABLED = False              # 자동매매 True/False\n",
    "LIVE_PROFIT_PROTECT_ENABLED = False      # 수익보호 True/False\n",
    "LIVE_TRADE_AMOUNT_WON = 1_000_000       # 종목당 금액\n",
    "LIVE_MAX_STOCKS = 5                     # 하루 진입 횟수\n",
    "LIVE_TOTAL_BUDGET_WON = 6_000_000       # 총 운용금액\n",
    "\n",
    "# v1.7.1 적응형 broker 사전조회 cache (사용자 변경 가능)\n",
    "LIVE_CACHE_PRECHECK_LEAD_PCT = 0.50       # TP/SL 기준 접근 선행폭(%p)\n",
    "LIVE_CACHE_REFRESH_SEC = 30.0             # 접근구간 정기 갱신(직전 완료 후)\n",
    "LIVE_CACHE_NEAR_DISTANCE_PCT = 0.20       # 근접 우선갱신 거리(%p)\n",
    "LIVE_CACHE_NEAR_MAX_AGE_SEC = 10.0        # 근접 시 이보다 오래된 cache 갱신\n",
    "LIVE_CACHE_MAX_AGE_SEC = 45.0             # 즉시청산에 허용할 최대 cache 나이\n",
    "\n",
    "# 위 다섯 줄과 연동되는 호환 alias\n",
    "LIVE_MAX_TRADES_PER_DAY = LIVE_MAX_STOCKS\n",
    "LIVE_MAX_CONCURRENT_POSITIONS = LIVE_MAX_STOCKS\n",
    "\n",
    "# False=실계좌 / True=키움 모의투자\n",
    "USE_MOCK = False\n",
    "\n",
    "# 실제 진입: FIRST_75_PASS / 정규장 / 09:30:00 미포함\n",
    "LIVE_ENTRY_MODE = \"FIRST_75_PASS\"\n",
    "LIVE_ENTRY_START = \"09:05\"\n",
    "LIVE_ENTRY_END = \"09:30\"\n",
    "LIVE_ALLOWED_SESSIONS = {\"MAIN\"}\n",
    "\n",
    "# 169개 EXIT_STRATEGIES 안의 전략명을 자유롭게 선택\n",
    "LIVE_STRATEGY = \"T250_S150\"\n",
    "\n",
    "# +1.00% 도달 뒤 +0.40%까지 밀리면 보호청산\n",
    "LIVE_PROFIT_PROTECT_ARM_PCT = 1.00\n",
    "LIVE_PROFIT_PROTECT_FLOOR_PCT = 0.40\n",
    "\n",
    "# 12시까지 +1.00% 미도달 종목은 +0.40% 회복 시 청산\n",
    "LIVE_NOON_RECOVERY_ENABLED = False\n",
    "LIVE_NOON_RECOVERY_TIME = \"12:00\"\n",
    "LIVE_NOON_RECOVERY_EXIT_PCT = 0.40\n",
    "\n",
    "# 실제 포지션은 NXT로 넘기지 않고 15:20 청산\n",
    "LIVE_FORCE_EXIT_ENABLED = True\n",
    "LIVE_FORCE_EXIT_TIME = \"15:20\"\n",
    "LIVE_FORCE_EXIT_RETRY_SEC = 15\n",
    "\n",
    "LIVE_MARKET_ORDER_BUFFER_PCT = 1.0\n",
    "LIVE_DAILY_MAX_LOSS_WON = 100_000\n",
    "ESTIMATED_ROUND_TRIP_COST_PCT = 0.24\n",
    "\n",
    "LIVE_MAIN_EXCHANGE = \"SOR\"\n",
    "LIVE_ORDER_TYPE = \"3\"\n",
    "\n",
    "\n",
    "# v1.7.0 연구 격리/계측 설정 (실제 주문과 분리)\n",
    "RESEARCH_QUEUE_MAX_ROWS = 20_000\n",
    "RESEARCH_QUEUE_WARN_ROWS = 5_000\n",
    "RESEARCH_BATCH_MAX_ROWS = 100\n",
    "RESEARCH_BATCH_INTERVAL_SEC = 1.0\n",
    "RESEARCH_QUEUE_P1_PUT_TIMEOUT_SEC = 5.0\n",
    "RESEARCH_FLUSH_TIMEOUT_SEC = 10.0\n",
    "RESEARCH_DETAIL_DEGRADE_ROWS = 20_000\n",
    "LIVE_CHECK_WARN_MS = 50.0\n",
    "PAPER_UPDATE_WARN_MS = 100.0\n",
    "BROKER_PRECHECK_MAX_WORKERS = 2\n",
    "BROKER_PRECHECK_TIMEOUT_SEC = 20.0\n",
    "\n",
    "PROFIT_PROTECT_SHADOW_ENABLED = True\n",
    "PROFIT_PROTECT_SHADOW_ARMS = [0.75, 1.00, 1.25, 1.50]\n",
    "PROFIT_PROTECT_SHADOW_FLOORS = [0.40, 0.50, 0.60, 0.70]\n",
    "NOON_RECOVERY_SHADOW_ENABLED = True\n",
    "NOON_RECOVERY_SHADOW_TIMES = [\"12:00\", \"12:30\", \"13:00\", \"13:30\", \"14:00\"]\n",
    "NOON_RECOVERY_SHADOW_EXIT_PCT = 0.40\n",
    "NEW_ENTRY_SHADOW_ENABLED = True\n",
    "NEW_ENTRY_SHADOW_RULE_VERSION = \"v170_provisional_1\"\n",
    "MARKET_PROXY_SNAPSHOT_ENABLED = True\n"
   ]
  },
